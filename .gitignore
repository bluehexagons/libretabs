# Godot generated state
.godot/

# Build artifacts
/build/*
!/build/.gdignore
/dist/*
!/dist/.gdignore
/exports/*
!/exports/.gdignore

# Local editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp
*.log

# Local inputs and research downloads (project fixtures belong under content/fixtures)
/user-midi/
/research-downloads/

# Credentials and local environment overrides
.env
.env.*
!.env.example
export_credentials.cfg

# Local release toolchain and Python caches
.tools/
__pycache__/
*.pyc
*.keystore
*.jks
*.p12
*.pfx

# Share the cleanup adapter, not local Basaltwater control state.
/.basaltwater/*
!/.basaltwater/cleanup.json
/artifacts/*
!/artifacts/.gdignore
