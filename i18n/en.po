msgid "HELP_TITLE"
msgstr "How to follow along"

msgid "HELP_TEXT"
msgstr "Tab is a map of the six guitar strings. The top line is string 1, the thinnest and highest-sounding string. A number tells you which fret to press; 0 means play the open string. The staff above is a pitch and rhythm reference: higher notes appear higher up. Guitar treble is written one octave above its sound. A measure is a small group of beats between vertical lines. The moving line follows the original timing; outlined notes show what is sounding. A ! marks a note this basic arrangement could not place. Use From and Through to repeat a short section."

msgid "SCALE"
msgstr "Control text size"

msgid "SCALE_VALUE"
msgstr "%d%%"

msgid "PSEUDO"
msgstr "Test long labels"

msgid "NOTICES"
msgstr "Licenses & notices"

msgid "STORAGE_SESSION"
msgstr "Display setting changed for this session. Settings could not be saved on this device."

msgid "OFFLINE_PENDING"
msgstr "Web offline readiness is not confirmed yet. On desktop the prototype works locally."

msgid "OFFLINE_READY"
msgstr "This prototype is cached for offline use. Clearing site storage requires reconnecting."

msgid "IMPORTING"
msgstr "Reading MIDI safely…"

msgid "LOADED"
msgstr "Loaded: %s"

msgid "SUSPENDED"
msgstr "Practice paused when the browser was hidden. Press Play to resume."

msgid "COUNTING"
msgstr "Count with the beat, then begin."

msgid "PLAYING_STATUS"
msgstr "Playing: %s"

msgid "ERR_SIZE"
msgstr "This prototype accepts files up to 256 KiB. Try a shorter MIDI file."

msgid "ERR_HEADER"
msgstr "This is not a Standard MIDI File. Choose a .mid or .midi file."

msgid "ERR_LENGTH"
msgstr "The MIDI file is truncated or a data length is invalid. Try another file."

msgid "ERR_FORMAT"
msgstr "Format 2 is not supported. Choose a format 0 or 1 MIDI file."

msgid "ERR_DIVISION"
msgstr "SMPTE or zero time division is not supported. Choose a ticks-per-quarter MIDI file."

msgid "ERR_TRACKS"
msgstr "The track structure is invalid or exceeds the prototype limit of 32 tracks."

msgid "ERR_END"
msgstr "A MIDI track has no valid end marker. Try another file."

msgid "ERR_VLQ"
msgstr "A MIDI timing value is too long. Try another file."

msgid "ERR_RUNNING"
msgstr "A MIDI event is missing its status byte. Try another file."

msgid "ERR_LIMIT"
msgstr "This file exceeds a prototype limit: 8,192 events, 2,048 notes, 256 measures or 10 minutes. Try a shorter file."

msgid "ERR_TEMPO"
msgstr "The MIDI file contains a zero tempo. Try another file."

msgid "ERR_METER"
msgstr "This MIDI meter is invalid or outside the prototype limits."

msgid "ERR_PORT"
msgstr "Multiple MIDI ports are not supported by this prototype."

msgid "ERR_DATA"
msgstr "A MIDI event contains invalid data bytes. Try another file."

msgid "ERR_STATUS"
msgstr "This file uses an unsupported MIDI status. Try another file."

msgid "ERR_READ"
msgstr "The file could not be read. Choose it again."

msgid "ERR_EMPTY"
msgstr "There are no pitched parts to practice. Try another file or a built-in example."

msgid "WARN_KEY"
msgstr "Imported key signatures are preserved, but this basic display uses explicit sharps."

msgid "WARN_CONTROLLERS"
msgstr "Some source controllers or system messages are preserved but not played by this prototype."

msgid "WARN_PARTIAL"
msgstr "A meter change creates a partial measure."

msgid "WARN_MAP"
msgstr "Timing metadata was recovered from a non-conductor track."

msgid "WARN_OVERLAP"
msgstr "Repeated pitches overlap; note endings use a deterministic oldest-first pairing."

msgid "WARN_PAIR"
msgstr "A missing or extra note ending was recovered. Check this passage by ear."

msgid "WARN_ZERO"
msgstr "Zero-duration events are preserved but excluded from tab and audio."

msgid "WARN_SHARED"
msgstr "Some parts share a MIDI channel; controller fidelity is deferred."

msgid "WARN_UNPLACED"
msgstr "! Unplaced notes remain audible. No source pitch was dropped, shifted or shortened."

msgid "WARN_TEXT"
msgstr "Non-ASCII MIDI metadata is preserved in the source; this prototype shows a safe label approximation."

msgid "DEMO_4"
msgstr "Dense chord · sound test"

