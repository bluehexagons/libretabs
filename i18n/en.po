msgstr "Show on manual pages"

msgid "NOTATION_BOTH"
msgstr "Tabs and sheet music"

msgid "NOTATION_TAB"
msgstr "Tabs only"

msgid "NOTATION_STAFF"
msgstr "Sheet music only"

