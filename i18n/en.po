msgstr "Microphone is off."

msgid "INPUT_MIC_CONNECTING"
msgstr "Waiting for microphone access…"

msgid "INPUT_MIC_READY"
msgstr "Microphone is active. Audio stays on this device."

msgid "INPUT_MIC_UNSUPPORTED"
msgstr "Microphone capture is unavailable here. Use a current browser over HTTPS, or a Windows/Linux app."

msgid "INPUT_MIC_DENIED"
msgstr "Microphone access was blocked. Check this site’s permissions, or open the player directly instead of inside another site. Then start again."

msgid "INPUT_MIC_EMPTY"
msgstr "No audio input was found. Connect a microphone or interface and try again."

msgid "INPUT_MIC_ERROR"
msgstr "Could not start audio input. Check system microphone permissions and the selected device, then start again."

msgid "INPUT_MIC_ENDED"
msgstr "The microphone disconnected or access ended. Choose an available device and start again."

msgid "INPUT_MIC_NO_SIGNAL"
msgstr "No audio frames arrived. Check the device and microphone permissions, then stop and start again."

msgid "INPUT_MIC_DEVICE"
msgstr "Audio input device (changing it stops capture)"

msgid "INPUT_MIC_DEFAULT"
msgstr "System default input"

msgid "INPUT_MIC_UNNAMED"
msgstr "Unnamed audio input"

msgid "INPUT_MIC_MISSING"
msgstr "Selected audio input unavailable"

msgid "INPUT_MIC_INSTRUMENT"
msgstr "Instrument setup"

msgid "INPUT_MIC_PIANO"
msgstr "Acoustic piano"

msgid "INPUT_MIC_ACOUSTIC"
msgstr "Acoustic guitar"

msgid "INPUT_MIC_ELECTRIC"
msgstr "Electric guitar · clean tone"

msgid "INPUT_MIC_RANGE"
msgstr "Listen to one clear note at a time. Piano: A1–C7; guitar: D2–F6; voice: A1–F6; bass: A0–F5; violin: F#3–C7; ukulele: F#3–F6. Distortion, effects and overlapping sounds may confuse the tuner. Instrument choices never change song pitches."

msgid "INPUT_LEVEL_QUIET"
msgstr "Input level: quiet — play a clear note"

msgid "INPUT_LEVEL_UNAVAILABLE"
msgstr "Input level: no audio measurement yet"

msgid "INPUT_LEVEL_PAUSED"
msgstr "Input level: tuner paused"

msgid "INPUT_LEVEL_CALIBRATING"
msgstr "Input level: measuring background noise"

msgid "INPUT_TUNER_START"
msgstr "Choose Start microphone to tune a note."

msgid "INPUT_TUNER_NO_AUDIO"
msgstr "Waiting for microphone audio. Check the microphone status above."

msgid "INPUT_LEVEL_OK"
msgstr "Input level: sound detected"

msgid "INPUT_LEVEL_CLIP"
msgstr "Input level: too loud — reduce the input gain"

msgid "INPUT_LEVEL_HELP"
msgstr "Current input level. Sound detected does not mean a note has been identified."

msgid "INPUT_TUNER_WAIT"
msgstr "Waiting for a clear, steady note…"

msgid "INPUT_TUNER_TARGET"
msgstr "Tuning target"

msgid "INPUT_TUNER_AUTO"
msgstr "Nearest note automatically"

msgid "INPUT_TUNER_STRING"
msgstr "String %d · %s"

msgid "INPUT_TUNER_LOCK"
msgstr "Hold the current note as target"

msgid "INPUT_TUNER_LOCKED"
msgstr "Held target · %s"

msgid "INPUT_REFERENCE"
msgstr "Tuning reference: A4 frequency (Hz)"

msgid "INPUT_CENTS_HELP"
msgstr "Frequency in Hz measures vibrations per second. Cents measure tuning: 100 cents is one semitone. A negative reading is low (flat); positive is high (sharp). Center means the selected target pitch. Match the A4 reference on your physical tuner before comparing."

msgid "INPUT_TUNER_LOW"
msgstr "Low / flat"

msgid "INPUT_TUNER_HIGH"
msgstr "High / sharp"

msgid "INPUT_TUNER_VALUE"
msgstr "%s · %.1f Hz · %+.1f cents"

msgid "INPUT_SETUP_RUN"
msgstr "Run input setup again"

msgid "INPUT_SETUP_CANCEL"
msgstr "Reset input setup"

msgid "INPUT_SETUP_IDLE"
msgstr "Setup is optional. Run it after changing rooms, microphones or instruments. It measures background noise, then checks three notes; it never retunes the instrument or hides tuning errors."

msgid "INPUT_SETUP_START_FIRST"
msgstr "Start the microphone and wait for it to become active, then run setup."

msgid "INPUT_SETUP_QUIET"
msgstr "Stay quiet for three seconds while background noise is measured."

msgid "INPUT_SETUP_NOTES"
msgstr "Play three separate, steady notes with silence between them."

msgid "INPUT_SETUP_NOTE_COUNT"
msgstr "Play three separate, steady notes with silence between them. Clear notes checked: %d of 3."

msgid "INPUT_SETUP_DONE"
msgstr "Input setup complete. You can rerun it whenever the room or instrument changes."

msgid "INPUT_SETUP_FAILED"
msgstr "Setup could not find a quiet background. Reduce background sound, check the input, then run setup again."

msgid "INPUT_SENSITIVITY"
msgstr "Listening sensitivity"

msgid "INPUT_SENSITIVITY_HELP"
msgstr "Higher sensitivity accepts softer notes. Run room setup to keep the threshold above background noise. Electronic piano is for a clean speaker heard through a microphone; use MIDI input for a direct MIDI connection."

msgid "INPUT_LISTEN"
msgstr "Use microphone for practice feedback"

msgid "INPUT_LISTEN_HELP"
msgstr "Return to practice and press Play. Listening checks single notes in the selected part while playback continues. Chords and overlapping source notes are not assessed. Piano sustain, ringing strings and other sounds can still confuse detection; unclear readings are not marked correct or wrong."

msgid "INPUT_MIC_TIMING"
msgstr "Estimate attack timing for this measured setup"

msgid "INPUT_MIC_TIMING_HELP"
msgstr "Off by default. Pitch detection takes time. Enable timing only after measuring this input/output setup; enter its remaining delay above. Early/late is an estimate, not a score. Tapping along cannot separate your timing from device delay. A device change or new setup disables timing again."

msgid "INPUT_MIC_PRIVACY"
msgstr "Audio is processed locally in short temporary buffers. It is never saved or uploaded. Capture stops when the app is hidden; press Start to resume. Setup and input choices last only for this session."

msgid "AUDIO_COMMANDS"
msgstr "Hands-free note commands"

msgid "AUDIO_COMMANDS_ENABLE"
msgstr "Enable hands-free note commands"

msgid "AUDIO_COMMANDS_HELP"
msgstr "Optional controls while the microphone is active. Start the microphone in Tuner & listening first. Use headphones or mute the speakers so playback cannot trigger commands. This switch is saved on this device; it never starts the microphone."

msgid "AUDIO_COMMANDS_WAKE"
msgstr "To open the command menu, first stay quiet for a second, then play E4, Bb4, F4, B4 in that order. Bb, also shown as A#, means B-flat: the key just below B. Hold each note for about three quarters of a second and silence it for about a third of a second before the next. On a guitar, use the thinnest string at frets 0, 6, 1, 7. You can start elsewhere: keep the same distances between pitches and the menu will adapt."

msgid "AUDIO_COMMANDS_LIMIT"
msgstr "Play separate notes, never a chord. After the menu opens, you have eight seconds to choose a command. Play its note twice, silencing it between repetitions; the second release confirms the action. A different note, a timeout or interrupted detection cancels. This unusual phrase reduces accidental activation but cannot guarantee it. Disable these controls whenever you prefer ordinary tuning."

msgid "AUDIO_COMMANDS_OFF"
msgstr "Note commands are off."

msgid "AUDIO_COMMANDS_UNAVAILABLE"
msgstr "Commands need an active microphone and steady detection. They are unavailable during setup, import, capture presentation or other menus."

msgid "AUDIO_COMMANDS_IDLE"
msgstr "Ready for the activation phrase."

msgid "AUDIO_COMMANDS_WAKE_PROGRESS"
msgstr "Activation phrase: %d of 4 notes."

msgid "AUDIO_COMMANDS_ARMED"
msgstr "Listening for a command. Play one of the notes below twice."

msgid "AUDIO_COMMANDS_CONFIRM"
msgstr "Play %s once more, then silence it to confirm."

msgid "AUDIO_COMMANDS_COOLDOWN"
msgstr "Waiting before the next phrase. Allow three seconds and a quiet gap."

msgid "AUDIO_COMMANDS_CANCEL"
msgstr "Cancel pending note command"

msgid "AUDIO_COMMANDS_CHOICE_PLAY_PAUSE"
msgstr "%s twice — Play or pause"

msgid "AUDIO_COMMANDS_CHOICE_REPLAY"
msgstr "%s twice — Replay the loop or song from its start"

msgid "AUDIO_COMMANDS_CHOICE_SLOWER"
msgstr "%s twice — Slower by 5 percentage points"

msgid "AUDIO_COMMANDS_CHOICE_FASTER"
msgstr "%s twice — Faster by 5 percentage points"

msgid "AUDIO_COMMANDS_DONE_PLAY_PAUSE"
msgstr "Note command: Play / Pause."

msgid "AUDIO_COMMANDS_DONE_REPLAY"
msgstr "Note command: replay from the start."

msgid "AUDIO_COMMANDS_DONE_SLOWER"
msgstr "Note command: slower."

msgid "AUDIO_COMMANDS_DONE_FASTER"
msgstr "Note command: faster."

msgid "AUDIO_COMMANDS_SHORT_PLAY_PAUSE"
msgstr "%s twice — Play / Pause"

msgid "AUDIO_COMMANDS_SHORT_REPLAY"
msgstr "%s twice — Replay"

msgid "AUDIO_COMMANDS_SHORT_SLOWER"
msgstr "%s twice — Slower"

msgid "AUDIO_COMMANDS_SHORT_FASTER"
msgstr "%s twice — Faster"

msgid "INPUT_MIC_DIGITAL_PIANO"
msgstr "Electronic piano (speaker to microphone)"

msgid "INPUT_MIC_VOICE"
msgstr "Voice"

msgid "INPUT_MIC_BASS"
msgstr "Bass guitar"

msgid "INPUT_MIC_VIOLIN"
msgstr "Violin"

msgid "INPUT_MIC_UKULELE"
msgstr "Ukulele (high G)"

msgid "INPUT_TUNER_ENABLED"
msgstr "Tuner on"

msgid "INPUT_PLAYBACK_MUTE"
msgstr "Mute practice audio"

msgid "INPUT_PLAYBACK_MUTE_HELP"
msgstr "Mute all app notes and clicks while the score keeps moving. Use this when your microphone hears the phone speaker. Your volume settings stay saved."

msgid "INPUT_TARGET_CUSTOM"
msgstr "Choose a note"

msgid "INPUT_TARGET_NOTE"
msgstr "Note name"

msgid "INPUT_TARGET_OCTAVE"
msgstr "Octave number"

msgid "INPUT_TARGET_HELP"
msgstr "Choose a note name and octave for a fixed tuning target. An octave is a group of twelve notes; C4 is middle C. Targets outside the selected instrument’s listening range cannot be measured."

msgid "INPUT_TARGET_CLASS"
msgstr "%s"

msgid "INPUT_TUNER_PAUSED"
msgstr "Tuner paused — switch Tuner on to listen again"
