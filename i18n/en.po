msgstr "Settings\nPlayback, score, sound and appearance"

msgid "TV_VIEW"
msgstr "Theater"

msgid "CARD_TV_VIEW"
msgstr "Theater\nMore music in the same player"

msgid "TV_INTRO"
msgstr "Theater shows more music in the same player, using the full window. Recommended for desktops, tablets and larger displays. Adjust music zoom for comfortable reading, and Music lines for the amount shown. Each view remembers its own layout. Use Theater again to return to your regular view; fullscreen is optional."

msgid "TV_ENTER"
msgstr "Enter Theater"

msgid "TV_SETUP"
msgstr "Optional TV mirroring:\n1. Turn your phone or tablet sideways.\n2. Use your phone’s screen-mirroring controls to connect to a compatible TV. On iPhone or iPad, use Screen Mirroring in Control Center; on Android, use your device’s casting controls or Google Home.\n3. Return here and select Theater. Press Play when you are ready.\n\nMirroring shows the same picture on your phone and TV. LibreTabs does not connect to a TV itself. Keep this app visible; switching away pauses practice. Use the Fullscreen button to fill the display. Press it again or press Escape to exit."

msgid "TV_TIMING"
msgstr "Wireless mirroring can delay the picture and sound. Check them together before practising in time. A cable may work better for your setup."

msgid "TV_APPLE_HELP"
msgstr "Apple mirroring help (opens browser)"

msgid "TV_ANDROID_HELP"
msgstr "Google casting help (opens browser)"

msgid "TV_MORE_MUSIC"
msgstr "More music"

msgid "TV_LARGE_NOTES"
msgstr "Larger notes"

msgid "TV_EXIT"
msgstr "Return to regular view"

msgid "TV_PROGRESS"
msgstr "Measure %d / %d · Speed %d%%"

msgid "TV_READY"
msgstr "Press Play when you are ready."

msgid "FULLSCREEN"
msgstr "Fullscreen"

msgid "EXIT_FULLSCREEN"
msgstr "Exit fullscreen"

msgid "FULLSCREEN_UNAVAILABLE"
msgstr "Fullscreen is unavailable here. Use your browser’s fullscreen option, or open the player directly if it is embedded in another page."

msgid "SPEED_ZERO"
msgstr "Speed is 0%. Increase the speed, then press Play to resume."

msgid "MUSIC_LAYOUT_HELP"
msgstr "Use more lines to see a longer passage, or fewer lines for taller music. Note spacing fits more notes across without shrinking their height. Staff height gives the five pitch lines more room. Settings are remembered separately for regular and Theater views."

msgid "MUSIC_LINES"
msgstr "Up to %d music lines"

msgid "MUSIC_LINES_HELP"
msgstr "Consecutive lines of music share the available height. Short screens show fewer lines to keep them readable. More than one line follows playback in pages."

msgid "MUSIC_SPACING"
msgstr "Note spacing: %d%%"

msgid "MUSIC_SPACING_HELP"
msgstr "Lower spacing fits more notes across the screen without reducing staff height."

msgid "MUSIC_STAFF"
msgstr "Staff height: %d%%"

msgid "MUSIC_STAFF_HELP"
msgstr "Give the five pitch lines more height relative to the other notation rows. Notes and highlights stay aligned with their lines."

msgid "MEASURE_SHORT"
msgstr "Measure %d"

msgid "MEASURE_NUMBER_ONLY"
msgstr "%d"

msgid "TV_ZOOM"
msgstr "Music zoom: %d%%"

msgid "TV_ZOOM_HELP"
msgstr "Calibrate the music for your screen and viewing distance. Smaller zoom fits more music; larger zoom makes notes easier to read. Use the slider with a pointer, touch, or the arrow keys when focused."

msgid "SHOW_CONTROLS"
msgstr "Show controls"

msgid "THEATER_REVEAL_TIP"
msgstr "Show playback controls without pausing (F10). Controls tuck away again after eight seconds."

msgid "LAST_STATUS"
msgstr "Show latest message"

msgid "THEATER_RECOMMEND"
msgstr "Using a desktop or tablet? Try Theater to see more music across the screen. You can adjust zoom and return to the regular view at any time."

msgid "THEATER_TRY"
msgstr "Try Theater"

msgid "THEATER_KEEP_CONTROLS"
msgstr "Keep controls visible while playing"

msgid "THEATER_CONTROLS_HELP"
msgstr "Keep the playback controls on screen for frequent adjustments. With this off, controls tuck into the edge as soon as you press Play. The count-in beats and Pause stay visible. Show controls or F10 brings the controls back without pausing."

msgid "THEATER_ENTER_TIP"
msgstr "Enter Theater for more music across your screen (F9). Right-click for Theater settings."

msgid "THEATER_EXIT_TIP"
msgstr "Return to your regular reading view (F9). Right-click for Theater settings."

msgid "SONG_FILE_HELP"
msgstr "MIDI files (.mid or .midi) contain note and timing instructions, not recorded audio. MP3s, PDFs and photos cannot be opened here. Choose a part below if the file has several instruments. Imports stay on this device and must be reopened after restarting."

msgid "SOUND_HELP"
msgstr "Listen to your selected part first. Then turn on Mute my part to play it yourself while hearing the enabled other parts. Turn it off to hear the reference again. Instrument and metronome volumes are separate."

msgid "HELP_WARNINGS"
msgstr "A ! or △ marks an arrangement warning, not a mistake you played. Open Songs, then About this arrangement to see which notes could not fit the guitar tab. Try another part or simpler music if needed."
