msgstr "Part %d · %s · channel %d"

msgid "ARRANGEMENT"
msgstr "Basic practice arrangement"

msgid "COVERAGE"
msgstr "Basic tab: %d of %d notes placed · E standard · guitar treble"

msgid "PROTOTYPE_LIMIT"
msgstr "Evaluation prototype: basic low-fret placement and rounded rhythm display, not a reviewed arrangement. Audio keeps the original timing. Controllers, pitch bend and drums are not reproduced yet."

msgid "PLAY"
msgstr "Play"

