msgstr "Seek to a measure"

msgid "LOOP"
msgstr "Loop measures"

msgid "FROM"
msgstr "From"

msgid "THROUGH"
msgstr "Through"

msgid "LOOP_RANGE"
msgstr "Choose the first and last measure to repeat"

msgid "CUE_READY"
msgstr "Your next note"

msgid "CUE_REST"
msgstr "Listen · your part rests here"

msgid "CUE_NOTE"
msgstr "String %d · fret %d"

msgid "CUE_UNPLACED"
msgstr "! Listen — this note has no tab placement"

msgid "MEASURE_TITLE"
msgstr "MEASURE %d / %d"

msgid "STAFF_REFERENCE"
msgstr "Staff · rhythm reference"

msgid "TAB_PRIMARY"
msgstr "TAB · FRETS"

msgid "DENSE_DISPLAY"
msgstr "! Dense measure: some symbols are hidden."

