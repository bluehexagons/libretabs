msgstr "Previous page"

msgid "PAGE_NEXT"
msgstr "Next page"

msgid "PAGE_NUMBER"
msgstr "Page %d of %d"

msgid "PAGE_PLAYBACK"
msgstr "Go to playing page"

msgid "NEXT_NOTE"
