; SPDX-License-Identifier: Apache-2.0
config_version=5

[application]
config/name="LibreTabs Prototype"
config/version="0.0.1-m0"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=850
window/size/window_width_override=1100
window/size/window_height_override=850
window/stretch/mode="disabled"
window/stretch/scale_mode="fractional"
window/per_pixel_transparency/allowed.web=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.96, 0.97, 0.99, 1)

[internationalization]
locale/translations=PackedStringArray("res://i18n/en.po")
locale/fallback="en"

[debug]
gdscript/warnings/treat_warnings_as_errors=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[editor_plugins]
enabled=PackedStringArray("res://addons/offline_export/plugin.cfg")
